# ---------------------------------------------------------------------------
# CoupleRoom configuration. Copy this file to `.env` and edit the values.
#   cp .env.example .env
# Everything here is optional except ROOM_PASSWORD if you want a private room.
# ---------------------------------------------------------------------------

# ---- Server -----------------------------------------------------------------
# Interface and port the Node server listens on.
# Keep HOST=127.0.0.1 when you put a reverse proxy (Caddy/nginx) in front.
HOST=127.0.0.1
PORT=5000

# The room both of you join. Changing it just changes the default room id.
ROOM_NAME=couple-room

# Shared password required to read/send chat messages. Leave empty for an open
# room. Call and watch-together always work; only chat is gated.
ROOM_PASSWORD=change-me

# Where the built web app lives. Empty = ./web/dist next to this file.
STATIC_DIR=

# SQLite database file. Empty = ./data/couple-room.db next to this file.
DB_PATH=

# How long a chat unlock lasts, and chat limits.
CHAT_TOKEN_TTL_MS=43200000
MAX_MESSAGE_CHARS=4000
MESSAGE_HISTORY=120

# ---- ICE / TURN -------------------------------------------------------------
# TURN relays media when the two of you are behind NATs that cannot reach each
# other directly. Without TURN, calls still work on the same network or with
# friendly NATs, but a relay makes them reliable.
#
# TURN_MODE:
#   none       -> only public STUN servers (no relay)
#   static     -> use the TURN server(s) in STATIC_ICE (self-hosted coturn)
#   cloudflare -> generate short-lived credentials from Cloudflare Realtime TURN
TURN_MODE=none

# Used in "none" and "static" modes.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# Comma/newline separated list for TURN_MODE=static. Format:
#   turn:turn.example.com:3478?transport=udp|username|credential
# You may also paste a JSON array of RTCIceServer objects instead.
STATIC_ICE=

# Only for TURN_MODE=cloudflare (Cloudflare Realtime -> TURN -> your key).
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Lifetime of generated Cloudflare credentials and how long to cache them.
TURN_TTL=21600
TURN_CACHE_MS=10800000
